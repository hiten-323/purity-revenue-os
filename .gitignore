
# Credentials. Never commit these. ecosystem.config.js reads every secret from
# backend/.env at load time, so the config file itself stays safe to track.
.env
*.env
.env.*
!.env.example

# `*.env` matches only files ENDING in .env, so a working copy like
# .env.bak-before-store-fix sat untracked and fully committable while holding
# every live credential. `.env.*` closes that: any sidecar of a .env file is
# ignored regardless of what is appended to it.
*.env.*
!.env.example.*

# Lead data. purity_beans.db holds contact records for real businesses —
# names, email addresses and phone numbers belonging to third parties who
# never agreed to appear in a public repository. The schema lives in
# backend/app/models/, so the application is fully reproducible without it.
*.db
*.db.*
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Runtime logs. autostart.log and watchdog.log were tracked in the previous
# repository, which meant every process restart showed up as a source change —
# and log lines can carry credentials or lead data straight into a commit.
*.log
logs/

# Data exports and backups — same third-party contact data as the database.
removed_leads_backup.json
*_backup.json
*.csv

# Call sheets and any other spreadsheet export. A call sheet is 1,400+ real
# businesses with names, addresses and phone numbers — the same third-party
# contact data as the database, in a format that is far easier to email
# somewhere by accident. Regenerate with scripts/export_call_sheet.py.
exports/
*.xlsx
*.xls

# Compiled bytecode — 121 .pyc files were tracked, so every run dirtied the
# working tree and a stale .pyc could ship instead of the source beside it.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Dependencies and build output
node_modules/
.next/
out/
build/
dist/
venv/
.venv/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
