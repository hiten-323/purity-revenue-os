# AI generation (contact disambiguation, tender analysis) — free tier
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Lead discovery
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Outbound email (Zoho SMTP + IMAP)
SENDER_EMAIL=your_sender@yourdomain.com
SENDER_NAME=Your Name
ZOHO_APP_PASSWORD=your_zoho_app_password_here

# WhatsApp (AiSensy — Meta BSP, Project/Direct API)
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_NAME=

# Shopify (order sync)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_TOKEN=your_shopify_admin_token_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Founder document links (used in proposal/catalogue emails)
DOC_CATALOGUE=
DOC_FSSAI=
DOC_GST=
DOC_MSME=
DOC_PAN=
DOC_PRICELIST=
DOC_PROFILE=

# Background worker
AUTO_WARM_ENABLED=1
