# AI generation (contact disambiguation, tender analysis) — free tier
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Lead discovery
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Outbound email (Zoho SMTP + IMAP)
SENDER_EMAIL=your_sender@yourdomain.com
SENDER_NAME=Your Name
ZOHO_APP_PASSWORD=your_zoho_app_password_here

# WhatsApp (AiSensy — Meta BSP, Campaign API)
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_NAME=

# Shopify (order sync)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_TOKEN=your_shopify_admin_token_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Founder document links (used in proposal/catalogue emails)
DOC_CATALOGUE=
DOC_FSSAI=
DOC_GST=
DOC_MSME=
DOC_PAN=
DOC_PRICELIST=
DOC_PROFILE=

# Social proof — Instagram post shown in outreach / store embeds
DOC_INSTAGRAM=https://www.instagram.com/p/Db_nFMaAieK/
SOCIAL_INSTAGRAM_POST=https://www.instagram.com/p/Db_nFMaAieK/

# Background worker
AUTO_WARM_ENABLED=1

# Adaptive B2B outreach worker
# Keep provider secrets in backend/.env only. The worker records every
# provider result and never fabricates a send. Cold warming defaults to email;
# WhatsApp remains consent/template gated.
AUTO_OUTREACH_ENABLED=0
OUTREACH_INTERVAL_SECONDS=900
OUTREACH_BATCH_SIZE=20

# Consumed by the /whatsapp/webhook auth check.
WHATSAPP_WEBHOOK_SECRET=your_whatsapp_webhook_secret_here

# Optional — NOT used by purity-revenue-os core. Declared so a machine that
# already has these as Windows User env vars (other tools) is not flagged as
# "unmanaged". Keep existing values; no rotation required for this repo.
# Prefer moving them into backend/.env if you want them under the same file.
GEMINI_API_KEY=
KLAVIYO_PRIVATE_KEY=
