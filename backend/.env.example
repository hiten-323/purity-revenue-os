# AI generation — NVIDIA Nemotron primary, Cerebras fallback, Ollama last resort
# Keep the real key only in backend/.env; NEVER commit credentials.
ENVIRONMENT=development
API_ADMIN_SECRET=
GATEWAY_ADMIN_SECRET=
DATABASE_URL=sqlite:///purity_beans.db
REDIS_URL=redis://127.0.0.1:6379/0
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Existing fallback AI generation
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# Local final fallback (only used if hosted providers fail)
OLLAMA_MODEL=llama3.2:3b

# Lead discovery = OpenStreetMap only (Nominatim + Overpass). No Google billing.
DISCOVERY_MAPS_PROVIDER=osm
# Optional etiquette string for public Nominatim
# OSM_USER_AGENT=PurityRevenueOS/1.0 (contact=you@example.com)
# GOOGLE_MAPS_API_KEY is NOT used for discovery (legacy unused)
# GOOGLE_MAPS_API_KEY=

# Outbound email (Zoho SMTP + IMAP)
SENDER_EMAIL=your_sender@yourdomain.com
SENDER_NAME=Your Name
ZOHO_APP_PASSWORD=your_zoho_app_password_here

# WhatsApp (AiSensy — Meta BSP, Campaign API)
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_NAME=
# Separate, dedicated campaign for the one message a lead gets right after
# asking for WhatsApp ON a qualification call (WHATSAPP_OPT_IN) — see
# smart_outreach._call_followup_text(). Meta approves exact template text
# per campaign, and this content is not the same as whatever
# AISENSY_CAMPAIGN_NAME above is used for, so it needs its own approved
# template/campaign in AiSensy, not a reuse of an existing one (especially
# not one of the transactional order-flow campaigns — see nuraveda/whatsapp
# notes on why cold/B2B content must never go through a utility campaign).
# Falls back to AISENSY_CAMPAIGN_NAME if left blank.
AISENSY_CAMPAIGN_CALL_FOLLOWUP=

# Shopify (order sync)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_TOKEN=your_shopify_admin_token_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Founder document links
DOC_CATALOGUE=
DOC_FSSAI=
DOC_GST=
DOC_MSME=
DOC_PAN=
DOC_PRICELIST=
DOC_PROFILE=

DOC_INSTAGRAM=https://www.instagram.com/p/Db_nFMaAieK/
SOCIAL_INSTAGRAM_POST=https://www.instagram.com/p/Db_nFMaAieK/

AUTO_WARM_ENABLED=1
SMART_OUTREACH_ENABLED=0
AUTO_OUTREACH_ENABLED=0
AISENSY_ENABLED=0
OUTREACH_INTERVAL_SECONDS=900
OUTREACH_BATCH_SIZE=20

WHATSAPP_WEBHOOK_SECRET=your_whatsapp_webhook_secret_here
VAPI_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=

GEMINI_API_KEY=
KLAVIYO_PRIVATE_KEY=

# Public storefront, appended to every outbound email signature.
# Verified: p3online.in redirects to https://www.p3online.in/ (200).
WEBSITE_URL=https://www.p3online.in

# Catalogue link. LEAVE EMPTY until a real hosted URL exists.
#
# Used ONLY on the CATALOGUE_REQUESTED path — never in the signature, and never
# on a cold first touch. The catalogue follows an explicit yes; attaching it to
# cold mail breaks the locked lifecycle rule and makes "would you like me to
# send the catalogue?" a hollow ask.
#
# Never a placeholder: an invented or broken link costs more than no link.
PURITY_BEANS_CATALOGUE_URL=
# Legacy alias, still read if the canonical name is unset.
CATALOGUE_URL=

# ── AI voice calling: Nuraveda / LiveKit sidecar (NOT Bolna, NOT VAPI) ───────
# OFF by default. Every one of these must be set AND AI_CALLING_ENABLED=1
# before a single number can be dialled. voice_router.place_call is the
# choke point that reads this flag; founder_call_pipeline.may_place_ai_call
# is the per-lead permission gate. Email consent is not call consent.
#
# Keep SMART_OUTREACH_ENABLED, AUTO_OUTREACH_ENABLED and AISENSY_ENABLED
# at 0 until production activation is an explicit, separate step.
AI_CALLING_ENABLED=0
AI_CALLING_KILL_SWITCH=
VOICE_PROVIDER=nuraveda
NURAVEDA_ENABLED=0
NURAVEDA_URL=http://127.0.0.1:3104
NURAVEDA_TOOL_SECRET=
NURAVEDA_PROFILE=ai-voice-agent
NURAVEDA_LANG=hi-IN

# ── Scrapling Web Intelligence (OFF by default) ─────────────────────────────
# Scrapling runs as a separate MCP server. Purity Revenue OS only uses it for
# web research/enrichment; it has no authority to send email/WhatsApp/calls.
SCRAPLING_ENABLED=0
SCRAPLING_MCP_URL=http://127.0.0.1:8000/mcp
SCRAPLING_CYCLE_HOURS=24
SCRAPLING_LIMIT=20
# Allow high-protection/stealth fetching only when explicitly enabled.
SCRAPLING_ALLOW_STEALTH=0
# Required when Scrapling is served over authenticated Streamable HTTP.
# SCRAPLING_MCP_AUTH_TOKEN=replace_with_a_long_random_token
