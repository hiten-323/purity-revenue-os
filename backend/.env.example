# AI generation (contact disambiguation, tender analysis) — free tier
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Lead discovery = OpenStreetMap only (Nominatim + Overpass). No Google billing.
DISCOVERY_MAPS_PROVIDER=osm
# Optional etiquette string for public Nominatim
# OSM_USER_AGENT=PurityRevenueOS/1.0 (contact=you@example.com)
# GOOGLE_MAPS_API_KEY is NOT used for discovery (legacy unused)
# GOOGLE_MAPS_API_KEY=

# Outbound email (Zoho SMTP + IMAP)
SENDER_EMAIL=your_sender@yourdomain.com
SENDER_NAME=Your Name
ZOHO_APP_PASSWORD=your_zoho_app_password_here

# WhatsApp (AiSensy — Meta BSP, Campaign API)
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_NAME=

# Shopify (order sync)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_TOKEN=your_shopify_admin_token_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Founder document links
DOC_CATALOGUE=
DOC_FSSAI=
DOC_GST=
DOC_MSME=
DOC_PAN=
DOC_PRICELIST=
DOC_PROFILE=

DOC_INSTAGRAM=https://www.instagram.com/p/Db_nFMaAieK/
SOCIAL_INSTAGRAM_POST=https://www.instagram.com/p/Db_nFMaAieK/

AUTO_WARM_ENABLED=1
AUTO_OUTREACH_ENABLED=0
OUTREACH_INTERVAL_SECONDS=900
OUTREACH_BATCH_SIZE=20

WHATSAPP_WEBHOOK_SECRET=your_whatsapp_webhook_secret_here

GEMINI_API_KEY=
KLAVIYO_PRIVATE_KEY=

# Public storefront, appended to every outbound email signature.
# Verified: p3online.in redirects to https://www.p3online.in/ (200).
WEBSITE_URL=https://www.p3online.in

# Catalogue link. LEAVE EMPTY until a real hosted URL exists.
#
# Used ONLY on the CATALOGUE_REQUESTED path — never in the signature, and never
# on a cold first touch. The catalogue follows an explicit yes; attaching it to
# cold mail breaks the locked lifecycle rule and makes "would you like me to
# send the catalogue?" a hollow ask.
#
# Never a placeholder: an invented or broken link costs more than no link.
PURITY_BEANS_CATALOGUE_URL=
# Legacy alias, still read if the canonical name is unset.
CATALOGUE_URL=

# ── AI voice calling: Bolna (agent) over Exotel (telephony) ──────────────────
# OFF by default. Every one of these must be set AND AI_CALLING_ENABLED=1
# before a single number can be dialled.
#
# Consent is checked separately and is NOT satisfied by configuring this:
# calling_agent refuses any lead whose consent_status is UNKNOWN. All 1,831
# current leads are UNKNOWN, so this will correctly dial nobody until consent
# is recorded from a reply, a WhatsApp opt-in, or a founder call.
AI_CALLING_ENABLED=0
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# The Exotel virtual number the agent calls from, in E.164 (+91...).
BOLNA_FROM_NUMBER=
# Override only if Bolna changes its API host.
BOLNA_BASE_URL=https://api.bolna.dev

# ── Scrapling Web Intelligence (OFF by default) ─────────────────────────────
# Scrapling runs as a separate MCP server. Purity Revenue OS only uses it for
# web research/enrichment; it has no authority to send email/WhatsApp/calls.
SCRAPLING_ENABLED=0
SCRAPLING_MCP_URL=http://127.0.0.1:8000/mcp
# Required when Scrapling is served over authenticated Streamable HTTP.
# SCRAPLING_MCP_AUTH_TOKEN=replace_with_a_long_random_token
